{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch Project (MinGW)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/${workspaceFolderBasename}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "preLaunchTask": "Build project (gcc via CodeBlocks MinGW)",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/Program Files/CodeBlocks/MinGW/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Habilita pretty-printing para gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "trace": false,
        "engineLogging": false,
        "programOutput": true,
        "exceptions": false
      }
    }
  ]
}